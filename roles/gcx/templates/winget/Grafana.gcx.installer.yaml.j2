# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.12.0.schema.json
PackageIdentifier: Grafana.gcx
PackageVersion: {{ gcx_latest_version }}
InstallerType: zip
NestedInstallerType: portable
UpgradeBehavior: uninstallPrevious
NestedInstallerFiles:
  - RelativeFilePath: gcx.exe
    PortableCommandAlias: gcx
Installers:
  - Architecture: x64
    InstallerUrl: {{ gcx_windows_x64_asset.browser_download_url }}
    InstallerSha256: {{ gcx_windows_x64_asset.digest | regex_replace('^sha256:', '') | upper }}
  - Architecture: arm64
    InstallerUrl: {{ gcx_windows_arm64_asset.browser_download_url }}
    InstallerSha256: {{ gcx_windows_arm64_asset.digest | regex_replace('^sha256:', '') | upper }}
ManifestType: installer
ManifestVersion: 1.12.0
