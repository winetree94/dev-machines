# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.12.0.schema.json
PackageIdentifier: NerdFonts.Agave
PackageVersion: {{ agave_nerd_font_latest_version }}
InstallerType: zip
NestedInstallerType: font
Scope: user
UpgradeBehavior: install
Installers:
  - Architecture: neutral
    InstallerUrl: {{ agave_nerd_font_latest_asset.browser_download_url }}
    InstallerSha256: {{ agave_nerd_font_latest_asset.digest | regex_replace('^sha256:', '') | upper }}
    NestedInstallerFiles:
{% for font_file in agave_nerd_font_files %}
      - RelativeFilePath: {{ font_file }}
{% endfor %}
ManifestType: installer
ManifestVersion: 1.12.0
